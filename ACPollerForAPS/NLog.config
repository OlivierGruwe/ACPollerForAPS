<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="false"
      internalLogLevel="Off">
  <!--
    Deux cibles :
      - file    : journal fichier détaillé (rotation + purge).
      - eventlog: journal d'événements Windows dédié "ACPollerForAPS", pour la
                  SUPERVISION. Reçoit les Warn/Error (les incidents) ; les
                  événements métier explicites (démarrage, résumé de passage)
                  sont écrits par le code via EventLogWriter.

    La source Event Log "ACPollerForAPS" est créée à l'installation du service
    (droits admin). Si elle n'existe pas, NLog échoue silencieusement sur cette
    cible (throwConfigExceptions=false) et le fichier reste disponible.

    Niveau de log : Info par défaut. Passer minlevel à "Debug" pour diagnostiquer
    (sans recompiler), puis revenir à "Info".
  -->
  <targets>
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/current.log"
            keepFileOpen="false"
            encoding="utf-8"
            layout="${longdate} | ${level:uppercase=true} | ${threadname} | ${logger} | ${message} ${exception:format=tostring}"
            archiveFileName="${basedir}/logs/archive/{#}.log"
            archiveNumbering="Date"
            archiveDateFormat="yyyy-MM-dd"
            archiveEvery="Day"
            archiveAboveSize="10485760"
            maxArchiveFiles="30"
            concurrentWrites="true" />

    <target xsi:type="EventLog" name="eventlog"
            source="ACPollerForAPS"
            log="ACPollerForAPS"
            layout="${message} ${exception:format=tostring}" />
  </targets>
  <rules>
    <!-- fichier : tout à partir de Info -->
    <logger name="*" minlevel="Info" writeTo="file" />
    <!-- Event Log : seulement les incidents (Warn et au-dessus) -->
    <logger name="*" minlevel="Warn" writeTo="eventlog" />
  </rules>
</nlog>
