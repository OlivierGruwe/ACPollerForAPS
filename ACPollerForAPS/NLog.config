<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="false"
      internalLogLevel="Off">
  <!--
    IMPORTANT (Windows Server 2012 / session 0) :
    En mode service, le processus n'a PAS de console attachée. On n'écrit
    donc QUE vers le fichier. throwConfigExceptions=false + internalLogLevel=Off :
    NLog ne doit jamais faire planter le service à cause du logging.

    Le chemin est basé sur ${basedir} (emplacement de l'assembly), pas sur le
    répertoire courant (qui est System32 sous compte service).

    NIVEAU DE LOG : réglé à Info par défaut. Pour diagnostiquer, passer le
    minlevel de la règle à "Debug" ci-dessous (modifiable SANS recompiler,
    NLog relit ce fichier à chaud), puis remettre "Info" ensuite.

    ROTATION : un fichier par jour (archiveEvery=Day) ET par taille
    (archiveAboveSize), avec purge automatique au-delà de maxArchiveFiles.
  -->
  <targets>
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/current.log"
            keepFileOpen="false"
            encoding="utf-8"
            layout="${longdate} | ${level:uppercase=true} | ${threadname} | ${logger} | ${message} ${exception:format=tostring}"
            archiveFileName="${basedir}/logs/archive/{#}.log"
            archiveNumbering="Date"
            archiveDateFormat="yyyy-MM-dd"
            archiveEvery="Day"
            archiveAboveSize="10485760"
            maxArchiveFiles="30"
            concurrentWrites="true" />
  </targets>
  <rules>
    <!-- Passer minlevel à "Debug" pour un diagnostic détaillé, "Info" en prod. -->
    <logger name="*" minlevel="Info" writeTo="file" />
  </rules>
</nlog>
