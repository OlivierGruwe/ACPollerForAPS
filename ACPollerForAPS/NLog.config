<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="false"
      internalLogLevel="Off">
	<!--
    Deux cibles :
      - file    : journal fichier détaillé (rotation + purge).
      - eventlog: journal d'événements Windows dédié "ACPollerForAPS".

    IMPORTANT : autoCreateEventSource="false".
    La source Event Log est créée par l'installeur du service (ProjectInstaller),
    dans le journal dédié "ACPollerForAPS". On NE laisse PAS NLog la créer, car
    NLog la créerait par défaut dans le journal "Application" — ce qui entre en
    conflit avec l'installeur (une source ne peut appartenir qu'à un seul journal)
    et provoque l'erreur "la source existe déjà". Si la source n'existe pas encore,
    NLog ignore simplement cette cible (grâce à throwConfigExceptions=false).

    Niveau de log : Info par défaut. Passer minlevel à "Debug" pour diagnostiquer.
  -->
	<targets>
		<target xsi:type="File" name="file"
				fileName="${basedir}/logs/current.log"
				keepFileOpen="false"
				encoding="utf-8"
				layout="${longdate} | ${level:uppercase=true} | ${threadname} | ${logger} | ${message} ${exception:format=tostring}"
				archiveFileName="${basedir}/logs/archive/{#}.log"
				archiveNumbering="Date"
				archiveDateFormat="yyyy-MM-dd"
				archiveEvery="Day"
				archiveAboveSize="10485760"
				maxArchiveFiles="30"
				concurrentWrites="true" />

		<target xsi:type="EventLog" name="eventlog"
				source="ACPollerForAPS.Service"
				log="ACPollerForAPS"
				autoCreateEventSource="false"
				layout="${message} ${exception:format=tostring}" />
	</targets>
	<rules>
		<logger name="*" minlevel="Info" writeTo="file" />
		<logger name="*" minlevel="Warn" writeTo="eventlog" />
	</rules>
</nlog>