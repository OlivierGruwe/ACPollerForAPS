<mah:MetroWindow x:Class="PipelineConfigWpf.HelpWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 Title="Help" Height="560" Width="440"
                 TitleCharacterCasing="Normal"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False">
    <DockPanel>
        <!-- en-tête -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource MahApps.Brushes.Accent}" Padding="14,10">
            <StackPanel>
                <TextBlock Text="ACPollerForAPS Assistant" FontSize="15" FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock Text="Configuration help (offline)" FontSize="11"
                           Foreground="White" Opacity="0.85" />
            </StackPanel>
        </Border>

        <!-- saisie en bas -->
        <Grid DockPanel.Dock="Bottom" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" KeyDown="InputBox_KeyDown"
                     mah:TextBoxHelper.Watermark="Ask your question…" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Send" Width="80" Margin="6,0,0,0"
                    Click="Send_Click"
                    Style="{StaticResource MahApps.Styles.Button.Square.Accent}" />
        </Grid>

        <!-- questions suggérées -->
        <Expander DockPanel.Dock="Bottom" Header="Frequently asked questions" Margin="10,0,10,0" IsExpanded="True">
            <ItemsControl x:Name="SuggestionsList" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Click="Suggestion_Click"
                                HorizontalContentAlignment="Left" Margin="0,2"
                                Padding="8,4" Cursor="Hand"
                                Background="Transparent"
                                BorderBrush="{DynamicResource MahApps.Brushes.Control.Border}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <!-- fil de conversation -->
        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="10">
            <ItemsControl x:Name="ChatList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="10,7" CornerRadius="8"
                                HorizontalAlignment="{Binding Align}"
                                MaxWidth="320"
                                Background="{Binding BubbleBrush}">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                       Foreground="{Binding Fore}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</mah:MetroWindow>
